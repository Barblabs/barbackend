export DATABASE_URL=postgres://postgres@localhost:5432/barbackend?sslmode=disable

# Seals CMDB Source credentials (ADR 0012): openssl rand -base64 32
export CREDENTIALS_KEY=

# Cognito user pool Users sign in with (ADR 0013); serve also needs the client id
export COGNITO_REGION=
export COGNITO_USER_POOL_ID=
export COGNITO_CLIENT_ID=
# Comma-separated origins allowed to call the HTTP API from a browser
export CORS_ALLOWED_ORIGINS=http://localhost:5173

# The Slack app Customers install from the portal (ADR 0025); the redirect URI
# must be registered in the Slack app and end in /slack/install/callback
export SLACK_CLIENT_ID=
export SLACK_CLIENT_SECRET=
export SLACK_REDIRECT_URI=http://localhost:8080/slack/install/callback

# iTop reader credentials, for connecting it through the HTTP API
# and used by go test ./internal/cmdb/provider/itop -record
export ITOP_URL=http://localhost:8000
export ITOP_USER=barb-reader
export ITOP_PASSWORD=

# The Agents (ADR 0016). Without credentials the API still serves, and asking
# an Agent answers 502.
export ANTHROPIC_API_KEY=
# Optional: move an Agent to another model
# export PRIORITIZER_MODEL=claude-haiku-5-5
# export LUNA_MODEL=claude-haiku-5-5
# export ANALISTA_MODEL=claude-opus-5-5
# export DRAFTER_MODEL=claude-opus-5-5
# export CARTOGRAFO_MODEL=claude-haiku-5-5
# Optional: raises NVD's rate limit for the NVD Feed
# export NVD_API_KEY=
