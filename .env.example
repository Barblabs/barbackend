export DATABASE_URL=postgres://postgres@localhost:5432/barbackend?sslmode=disable

# Seals CMDB Source credentials (ADR 0012): openssl rand -base64 32
export CREDENTIALS_KEY=

# serve acts for this Customer until authentication exists: local dev only
export CUSTOMER_ID=
# Comma-separated origins allowed to call the HTTP API from a browser
export CORS_ALLOWED_ORIGINS=http://localhost:5173

# iTop reader credentials, for connecting it through the HTTP API
# and used by go test ./internal/cmdb/provider/itop -record
export ITOP_URL=http://localhost:8000
export ITOP_USER=barb-reader
export ITOP_PASSWORD=
